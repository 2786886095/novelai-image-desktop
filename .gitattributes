# Hash-pinned upstream prompt bytes include CRLF; do not normalize the artifact.
/harness/community/infinite-gen4/infinite-gen-4.md -text
# Generated responsive JS embeds CSS strings; keep input and bundle deterministic.
/harness/plugins/studio-responsive/** text eol=lf

# Preserve hash-pinned upstream fonts, OFL notices and catalog bytes on every OS.
/public/ui-fonts/** -text
/mobile/assets/ui-fonts/** -text

# These checked-in upstream resources have byte-level provenance hashes.
# A Windows checkout must not silently rewrite their text line endings.
/shared/ig5-image-prompts.json -text
/shared/ig5-NOTICE.txt -text
/shared/ig5-LICENSE.txt -text
/mobile/assets/ig5/** -text
/THIRD_PARTY_NOTICES.md -text
/shared/official-image-metadata-fixtures/** -text
/shared/image-metadata-compat-fixtures/** -text

# Exact user-supplied template bytes and generated mobile catalogs.
/shared/templates/** -text
/shared/prompt-skill-catalog-v3.json -text
/shared/comic-template-catalog.json -text
/mobile/assets/prompt-skill-catalog-v3.json -text
/mobile/assets/comic-template-catalog.json -text
