    {
      "id": "native-pass",
      "responses": {
        "/user/data": {
          "status": 200,
          "data": {
            "subscription": {
              "tier": 0,
              "active": true,
              "trainingStepsLeft": 7
            }
          }
        }
      },
      "expectedOk": true,
      "expectedCode": "passed"
    },
